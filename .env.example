# ===== SkyRise AI 配置 =====
# 三家国内免费模型任选其一填写 Key 即可；都不填时自动使用免登录的 Pollinations 兜底。
# 建议把本文件复制为 .env 后填写。

# 硅基流动 SiliconFlow（推荐）
# 免费模型：Kwai-Kolors/Kolors 文生图 + Qwen/Qwen2.5-7B-Instruct 文本
# 注册即送额度，Kolors 永久免费：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# 智谱 Zhipu（推荐备选）
# 免费模型：cogview-3-flash 文生图 + glm-4-flash 文本
# 开放平台注册即可免费调用：https://open.bigmodel.cn
ZHIPU_API_KEY=

# AI 代理服务端口
PORT=3101
