{
  "name": "skyrise-pixel-habits",
  "private": true,
  "version": "1.0.0",
  "description": "SkyRise 像素习惯养成 - 孩子完成每日任务赚资源Token，AI文生图搭建摩天大楼，竣工后进入城市档案",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run server\" \"npm run client\"",
    "server": "node server/index.mjs",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
